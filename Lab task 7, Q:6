A = {1, 2, 3, 4}
B = {3, 4, 5, 6}

# 1. union - all unique elements
print("union:", A | B)

# 2. intersection - common
print("intersection:", A & B)

# 3. difference
print("A - B:", A - B)
print("B - A:", B - A)
# they are different because A-B removes B's elements from A, and B-A removes A's from B

# 4. symmetric difference - in either but not both
print("symmetric diff:", A ^ B)
